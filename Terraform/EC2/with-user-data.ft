provider "aws" {
  profile = "default" # AWS Credentials Profile configured on your local desktop terminal  $HOME/.aws/credentials
  region  = "us-east-1"
}

resource "aws_instance" "name" {
  ami           = "ami-0c1fe732b5494dc14"
  instance_type = "t2.micro"
  user_data     = file("command.sh") # file("${path.module}/command.sh") # Absolute path to file
  tags = {
    Name = "Terraform-EC2"
  }
}
-------------------------------------command.sh------------------------------------
#!/bin/bash
sudo yum update -y
sudo yum install -y httpd
sudo systemctl enable httpd
sudo systemctl start httpd
echo "<h1>Welcome to StackSimplify - APP-1</h1>" | sudo tee /var/www/html/index.html
sudo mkdir -p /var/www/html/app1
sudo bash -c 'cat <<EOF >> /var/www/html/app1/metadata.html
<!DOCTYPE html>
<html>
<body style="background-color:rgb(250, 210, 210);">
<h1>EC2 Instance Metadata</h1>
<pre>
EOF'

# Fetch instance identity document from metadata service
sudo curl http://169.254.169.254/latest/dynamic/instance-identity/document \
>> /var/www/html/app1/metadata.html

# Close HTML tags
sudo bash -c 'cat <<EOF >> /var/www/html/app1/metadata.html
</pre>
</body>
</html>
EOF'
